generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AbsenceType {
  vacation
  sickLeave
  other
}

model TeamMember {
  id          String @id @default(uuid())
  firstName   String
  lastName    String
  displayName String
  email       String @unique

  absences Absence[]

  substitutionsForMe Substitution[] @relation("SubstitutedTeamMember")
  substitutionsByMe  Substitution[] @relation("SubstituteTeamMember")

  createdAt DateTime @default(now())
}

model Absence {
  id           String      @id @default(uuid())
  teamMemberId String
  teamMember   TeamMember  @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  type      AbsenceType

  createdAt DateTime @default(now())
}

model Substitution {
  id String @id @default(uuid())

  teamMemberId String
  teamMember TeamMember @relation("SubstitutedTeamMember", fields: [teamMemberId], references: [id], onDelete: Cascade)

  substituteTeamMemberId String
  substituteTeamMember TeamMember @relation("SubstituteTeamMember", fields: [substituteTeamMemberId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
}