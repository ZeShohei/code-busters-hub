generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AbsenceType {
  vacation
  sickLeave
  other
}

enum RotationType {
  dispatcher
  deployment
}

enum TeamMemberRole {
  admin
  member
}

enum DeploymentExceptionType {
  rescheduled
  special
}

model TeamMember {
  id          String         @id @default(uuid())
  firstName   String
  lastName    String
  displayName String
  email       String         @unique
  active      Boolean        @default(true)
  role        TeamMemberRole @default(member)

  username     String? @unique
  passwordHash String?

  absences               Absence[]
  substitutionsByMe      Substitution[]        @relation("SubstituteTeamMember")
  rotationParticipations RotationParticipant[]
  deploymentExceptions   DeploymentException[]
  sessions               AuthSession[]

  createdAt DateTime @default(now())
}

model AuthSession {
  id String @id @default(uuid())

  tokenHash String @unique

  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([teamMemberId])
  @@index([expiresAt])
}

model LoginThrottle {
  id String @id @default(uuid())

  identifierHash String @unique

  failedAttempts  Int      @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model Absence {
  id           String     @id @default(uuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  type      AbsenceType

  substitution     Substitution?
  vacationHandover VacationHandover?

  createdAt DateTime @default(now())
}

model Substitution {
  id String @id @default(uuid())

  absenceId String  @unique
  absence   Absence @relation(fields: [absenceId], references: [id], onDelete: Cascade)

  substituteTeamMemberId String
  substituteTeamMember   TeamMember @relation("SubstituteTeamMember", fields: [substituteTeamMemberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model VacationHandover {
  id String @id @default(uuid())

  absenceId String  @unique
  absence   Absence @relation(fields: [absenceId], references: [id], onDelete: Cascade)

  emergencyContact String?

  featureBranches String?
  deploymentPlan   String?
  cicdStatus       String?
  environments     String?

  knownRisks   String?
  dependencies String?

  technicalDocumentation String?
  repositories            String?
  tickets                 String?

  notes String?

  tasks VacationHandoverTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VacationHandoverTask {
  id String @id @default(uuid())

  vacationHandoverId String
  vacationHandover   VacationHandover @relation(fields: [vacationHandoverId], references: [id], onDelete: Cascade)

  title       String
  repoBranch  String?
  status      String?
  nextSteps   String?
  responsible String?

  completed Boolean @default(false)

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vacationHandoverId])
}

model RotationConfig {
  id String @id @default(uuid())

  type          RotationType
  startDate     DateTime     @db.Date
  numberOfWeeks Int
  startIndex    Int

  participants RotationParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, startDate])
}

model RotationParticipant {
  id String @id @default(uuid())

  rotationConfigId String
  rotationConfig   RotationConfig @relation(fields: [rotationConfigId], references: [id], onDelete: Cascade)

  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  position Int

  @@unique([rotationConfigId, teamMemberId])
  @@unique([rotationConfigId, position])
}

model DeploymentException {
  id String @id @default(uuid())

  type DeploymentExceptionType

  originalDate   DateTime? @unique @db.Date
  deploymentDate DateTime  @db.Date

  teamMemberId String?
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deploymentDate])
}