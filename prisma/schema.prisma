generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AbsenceType {
  vacation
  sickLeave
  other
}

enum RotationType {
  dispatcher
  deployment
}

enum TeamMemberRole {
  admin
  member
}

model TeamMember {
  id          String         @id @default(uuid())
  firstName   String
  lastName    String
  displayName String
  email       String         @unique
  active      Boolean        @default(true)
  role        TeamMemberRole @default(member)

  username     String? @unique
  passwordHash String?

  absences               Absence[]
  substitutionsByMe      Substitution[]        @relation("SubstituteTeamMember")
  rotationParticipations RotationParticipant[]
  sessions               AuthSession[]

  createdAt DateTime @default(now())
}

model AuthSession {
  id String @id @default(uuid())

  tokenHash String @unique

  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([teamMemberId])
  @@index([expiresAt])
}

model LoginThrottle {
  id String @id @default(uuid())

  identifierHash String @unique

  failedAttempts  Int      @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model Absence {
  id           String     @id @default(uuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  type      AbsenceType

  substitution Substitution?

  createdAt DateTime @default(now())
}

model Substitution {
  id String @id @default(uuid())

  absenceId String  @unique
  absence   Absence @relation(fields: [absenceId], references: [id], onDelete: Cascade)

  substituteTeamMemberId String
  substituteTeamMember   TeamMember @relation("SubstituteTeamMember", fields: [substituteTeamMemberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model RotationConfig {
  id String @id @default(uuid())

  type          RotationType
  startDate     DateTime     @db.Date
  numberOfWeeks Int
  startIndex    Int

  participants RotationParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, startDate])
}

model RotationParticipant {
  id String @id @default(uuid())

  rotationConfigId String
  rotationConfig   RotationConfig @relation(fields: [rotationConfigId], references: [id], onDelete: Cascade)

  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  position Int

  @@unique([rotationConfigId, teamMemberId])
  @@unique([rotationConfigId, position])
}